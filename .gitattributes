# Normalize text files so macOS/Linux and Windows checkouts agree.
* text=auto

*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.epd text eol=lf
*.json text eol=lf

# Binary assets must never be line-ending converted.
*.nnue binary
